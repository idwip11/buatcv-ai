# LinkedIn OAuth 2.0 Credentials (Optional)
# If not provided, the app will smoothly fallback to Mock/Demo LinkedIn auto-fill & PDF Upload.
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# App Base URL (e.g. http://localhost:3000 in development or https://your-site.vercel.app in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
